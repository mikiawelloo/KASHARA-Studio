/* ------------------------------------------------------------------------- *
 *                                                                           *
 *                                 IMPORTANT                                 *
 *                                                                           *
 * ------------------------------------------------------------------------- *
 *                                                                           *
 * This is a stub Variant Theme for Yami named Default to populate the style
 * dropdown.
 *
 * If you are developing a custom theme it is HIGHLY RECOMMENDED that you
 * use Yami as a Base and apply your changes in a Variant Theme (.ovt).
 *
 * You can learn more about OBS Studio's theme system on our GitHub wiki:
 * https://github.com/obsproject/obs-studio/wiki/OBS-Studio-Theme-System
 *                                                                           *
 * ------------------------------------------------------------------------- */

@OBSThemeMeta {
    name: 'KASHARA Monochrome';
    id: 'com.obsproject.Yami.Original';
    extends: 'com.obsproject.Yami';
    author: 'Warchamp7';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #666666;
    --grey2: #505050;
    --grey3: #414141;
    --grey4: #303030;
    --grey5: #262626;
    --grey6: #1c1c1c;
    --grey7: #141414;
    --grey8: #090909;
    --blue1: #dddddd;
    --blue2: #a0a0a0;
    --blue3: #555555;
    --blue4: #383838;
    --blue5: #262626;
    --blue6: #181818;
    --primary: #555555;
    --primary_light: #777777;
    --primary_lighter: #dedede;
    --primary_dark: #383838;
    --primary_darker: #262626;
    --bg_window: #141414;
    --bg_base: #1c1c1c;
    --bg_preview: #090909;
    --border_radius: 2px;
    --border_radius_small: 1px;
    --border_radius_large: 3px;
    --palette_link: #dddddd;
    --palette_linkVisited: #bbbbbb;
}
QMenuBar { border-bottom: 1px solid #303030; }
QStatusBar { border-top: 1px solid #303030; }
QDockWidget::title { background: #202020; padding: 5px; border-bottom: 1px solid #333333; }
QPushButton { border-radius: 2px; }
QListWidget::item:selected, QTreeView::item:selected { background: #444444; color: #ffffff; }
QToolTip { background: #252525; color: #ffffff; border: 1px solid #555555; }

QToolBar#kasharaWorkspace { background: #171717; border-bottom: 1px solid #393939; spacing: 8px; padding: 7px; }
QLabel#kasharaBrand { color: #ffffff; font-weight: bold; }
QToolBar#kasharaWorkspace QToolButton { color: #eeeeee; background: #292929; border: 1px solid #414141; padding: 7px 12px; border-radius: 2px; }
QToolBar#kasharaWorkspace QToolButton:hover { background: #454545; }
